# Local SQLite file, shared by the web application and both workers.
DATABASE_PATH=./data/answerlens.db
# Optional public information URL included in the crawler user agent.
CRAWLER_INFORMATION_URL=
# Phase 3: set keys here in .env.local, never in NEXT_PUBLIC_ variables or browser code.
# Both keys enable mutual fallback; one key works with fallback disabled or the other unavailable.
# Generate keys at https://build.nvidia.com and https://openrouter.ai/settings/keys
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
# Model, primary provider, fallback and project budgets are configured in Company profile.

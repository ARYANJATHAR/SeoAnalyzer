# Local SQLite file, shared by the web application and all three workers.
DATABASE_PATH=./data/answerlens.db
# Optional public information URL included in the crawler user agent.
CRAWLER_INFORMATION_URL=
# Phase 3: set keys here in .env.local, never in NEXT_PUBLIC_ variables or browser code.
# Both keys enable mutual fallback; one key works with fallback disabled or the other unavailable.
# Generate keys at https://build.nvidia.com and https://openrouter.ai/settings/keys
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
# Optional owner-only settings. Users do not configure providers in the product.
# These override previously saved project settings; blank values use saved settings/defaults.
AI_PRIMARY_PROVIDER=nvidia
AI_FALLBACK_ENABLED=true
AI_MODEL=nemotron-super
AI_REQUEST_BUDGET=50
AI_PAGE_LIMIT=6
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.1
AI_TIMEOUT_SECONDS=60
